{"version":3,"term":{"cols":80,"rows":24,"type":"xterm-256color"},"timestamp":1767115444,"command":"bash /var/folders/jj/ftvsbr992rq6q1rh__57kynm0000gn/T/tmp.hnOYgznetU","title":"structured-error-handler / serr - Tuulbelt","env":{"SHELL":"/bin/zsh"}}
[0.020, "o", "# Structured Error Handler Demo\r\n"]
[1.013, "o", "\r\n# 1. Show demo with JSON output (default)\r\n"]
[0.514, "o", "$ serr demo\r\n"]
[1.569, "o", "{\r\n  \"name\": \"StructuredError\",\r\n  \"message\": \"Failed to connect to database\",\r\n  \"context\": [\r\n    {\r\n      \"operation\": \"handleGetUser\",\r\n      \"component\": \"UserController\",\r\n      \"metadata\": {\r\n        \"endpoint\": \"/api/users/12345\"\r\n      },\r\n      \"timestamp\": \"2025-12-30T17:24:07.932Z\"\r\n    },\r\n    {\r\n      \"operation\": \"fetchUserProfile\",\r\n      \"component\": \"UserService\",\r\n      \"metadata\": {\r\n        \"userId\": \"12345\"\r\n      },\r\n      \"timestamp\": \"2025-12-30T17:24:07.931Z\"\r\n    },\r\n    {\r\n      \"operation\": \"connectToDatabase\",\r\n      \"component\": \"DatabaseClient\",\r\n      \"metadata\": {\r\n        \"host\": \"localhost\",\r\n        \"port\": 5432\r\n"]
[0.000, "o", "      },\r\n      \"timestamp\": \"2025-12-30T17:24:07.930Z\"\r\n    }\r\n  ],\r\n"]
[2.021, "o", "\r\n# 2. Show demo with human-readable text format\r\n"]
[0.521, "o", "$ serr demo --format text\r\n"]
[0.736, "o", "\u001b[1G"]
[0.000, "o", "\u001b[0K"]
[0.186, "o", "[DB_CONNECTION_FAILED] Failed to connect to database\r\n\r\nContext:\r\n  → handleGetUser (UserController) {\"endpoint\":\"/api/users/12345\"}\r\n  → fetchUserProfile (UserService) {\"userId\":\"12345\"}\r\n  → connectToDatabase (DatabaseClient) {\"host\":\"localhost\",\"port\":5432}\r\n\r\nCaused by:\r\n  Connection refused\r\n"]
[0.006, "o", "\u001b[1G\u001b[0K"]
[0.000, "o", "⠙"]
[0.001, "o", "\u001b[1G\u001b[0K"]
[2.012, "o", "\r\n# 3. Parse a JSON error\r\n"]
[0.520, "o", "$ serr parse '{\"message\":\"Test error\",\"code\":\"TEST_CODE\",\"context\":[]}'\r\n"]
[0.765, "o", "\u001b[1G"]
[0.000, "o", "\u001b[0K"]
[0.186, "o", "[TEST_CODE] Test error\r\n"]
[0.006, "o", "\u001b[1G\u001b[0K⠙"]
[0.001, "o", "\u001b[1G\u001b[0K"]
[2.013, "o", "\r\n# 4. Validate JSON error format\r\n"]
[0.512, "o", "$ serr validate '{\"message\":\"Hello\"}'\r\n"]
[0.739, "o", "\u001b[1G"]
[0.000, "o", "\u001b[0K"]
[0.177, "o", "Valid error format\r\n"]
[0.006, "o", "\u001b[1G\u001b[0K"]
[0.000, "o", "⠙"]
[0.001, "o", "\u001b[1G\u001b[0K"]
[1.013, "o", "\r\n# 5. Show help\r\n"]
[0.519, "o", "$ serr --help\r\n"]
[0.794, "o", "\u001b[1G"]
[0.000, "o", "\u001b[0K"]
[0.185, "o", "Structured Error Handler - Error format with context preservation\r\n\r\nUsage:\r\n  structured-error-handler <command> [options] [input]\r\n\r\nCommands:\r\n  parse <json>     Parse a JSON error and format it\r\n  validate <json>  Validate JSON error format\r\n  demo             Show a demo of structured errors\r\n\r\nOptions:\r\n  -f, --format <format>  Output format: json, text (default: json)\r\n  -s, --stack           Include stack traces in output\r\n  -h, --help            Show this help message\r\n\r\nExamples:\r\n  # Parse and format an error\r\n  structured-error-handler parse '{\"message\":\"test\",\"context\":[]}'\r\n\r\n  # Validate error format\r\n  structured-error-handler validate '{\"message\":\"test\"}'\r\n\r\n  # Show demo\r\n  structured-error-handler demo --format text\r\n"]
[0.006, "o", "\u001b[1G\u001b[0K"]
[0.000, "o", "⠙"]
[0.001, "o", "\u001b[1G\u001b[0K"]
[2.010, "o", "\r\n# Done! Handle structured errors with the serr command.\r\n"]
[1.012, "x", "0"]
